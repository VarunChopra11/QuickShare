APP_NAME=QuickShare
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Expiration in minutes (Default: 10)
EXPIRY_MINUTES=10

# File & payload limits
MAX_FILE_SIZE_MB=50
MAX_TOTAL_SHARE_SIZE_MB=100
MAX_FILES_PER_SHARE=10
MAX_TEXT_LENGTH=50000

# Rate limiting
RATE_LIMIT_LOOKUP_PER_MINUTE=20
RATE_LIMIT_CREATE_PER_MINUTE=10
MAX_FAILED_ATTEMPTS=5
FAILED_ATTEMPT_LOCKOUT_SECONDS=60

# Background cleanup interval in seconds
CLEANUP_INTERVAL_SECONDS=30

# CORS origins (comma-separated or * for development)
CORS_ORIGINS=*
